--- pristine/src/MSC/xheaacsuperframe.cpp	2026-07-29 09:44:28.685227936 -0400
+++ dreambuild/src/MSC/xheaacsuperframe.cpp	2026-07-29 09:44:10.386674705 -0400
@@ -8,7 +8,7 @@
 void
 XHEAACSuperFrame::init(const CAudioParam& audioParam, unsigned frameSize)
 {
-    numChannels = audioParam.AM_MONO?1:2;
+    numChannels = (audioParam.eAudioMode==CAudioParam::AM_MONO)?1:2;
     superFrameSize = frameSize;
     payload.resize(0);
     borders.resize(0);
@@ -109,15 +109,17 @@
             break;
         default: // boundary in this superframe
             borders[0] += start;
-            if(borders[0]<2) return false;
-            borders[0] -= 2; // header not in payload
+            /* xHE fix: the frame border index already refers to the payload
+               section, the 2 header bytes were never pushed into payload. */
+            //if(borders[0]<2) return false;
+            //borders[0] -= 2; // header not in payload
             frameSize[0] = borders[0];
             //cerr << "border 0 is " << borders[0] << " bytes from start of payload" << endl;
             break;
         }
         for(unsigned i=1; i<borders.size(); i++) {
             borders[i] += start;
-            borders[i] -= 2; // header not in payload
+            //borders[i] -= 2; // header not in payload
             unsigned bytes = borders[i]-borders[i-1];
             frameSize[i] = bytes;
             //cerr << "border " << i << " is " << borders[i] << " bytes from start of payload" << endl;
@@ -129,6 +131,13 @@
     // now copy into the audioFrames for simplicty
     size_t i=0;
     audioFrame.resize(frameBorderCount);
+    /* xHE fix: no frame border in this super frame - nothing to hand to the
+       decoder yet, the payload stays buffered for the next super frame.
+       Without this the loop below dereferences audioFrame[0] on an empty
+       vector and the receiver segfaults. */
+    if(frameBorderCount == 0) {
+        return ok;
+    }
     audioFrame[i].resize(0);
     while(true) {
         audioFrame[i].push_back(payload.front());
